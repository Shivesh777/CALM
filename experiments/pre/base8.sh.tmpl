#!/bin/bash
# DynaME-protocol baselines (L=96, 20/5/75): pretrain, GD, Proceed, DynaME with prediction dumps.
W=/kaggle/working
M={MODEL}
chain () {
  H=$1; G=$2; OLR=$3
  COMMON="--dataset {DS} --border_type online --model $M --seq_len 96 --pred_len $H --itr 1 --gpu $G"
  python -u run.py $COMMON --learning_rate {PLR} --batch_size {PBS} --save_opt > $W/baseline_logs/pretrain_${M}_{DS}_H$H.log 2>&1
  DUMP_PREDS=$W/preds/GD__${M}__{DS}__L96__H$H python -u run.py $COMMON --online_method Online --online_learning_rate {GDLR} \
      --pin_gpu True --reduce_bs False --save_opt --only_test > $W/baseline_logs/gd_${M}_{DS}_H$H.log 2>&1
  DUMP_PREDS=$W/preds/Proceed__${M}__{DS}__L96__H$H python -u run.py $COMMON --batch_size {PCBS} --tune_mode down_up \
      --concept_dim {MID} --val_online_lr --diff_online_lr --pretrain --save_opt --online_method Proceed \
      --bottleneck_dim {BTL} --online_learning_rate $OLR --learning_rate {LR} --lradj type3 > $W/baseline_logs/proceed_${M}_{DS}_H$H.log 2>&1
  DUMP_PREDS=$W/preds/DynaME__${M}__{DS}__L96__H$H python -u run.py $COMMON --batch_size {PCBS} --pretrain --save_opt \
      --online_method DynaME --online_learning_rate {GDLR} --learning_rate {PLR} --lradj type3 \
      --krr_train_num 8 --period_num 2 --beta 0.3 --past_num 672 --krr_lambda 0.0001 --delta 0.01 > $W/baseline_logs/dyname_${M}_{DS}_H$H.log 2>&1
  grep -h "^mse:" $W/baseline_logs/*_${M}_{DS}_H$H.log
}
chain 24 0 {OLR24} &
chain 48 1 {OLR48} &
wait
chain 96 0 {OLR96}
ls -la $W/preds
