+                if _dump:
+                    def _cat16(lst):
+                        # = np.concatenate(lst, 0).astype(np.float16) (same values), but the float32 pieces are
+                        # released while copying: peak RAM ~1.5x instead of ~2.5x the float32 list (Traffic H96: 4.3 GB)
+                        if not lst:
+                            return np.zeros((0,), dtype=np.float16)
